       fhir:ElementDefinition.requirements [ fhir:value "Satisfies REQ-DE-27 (ICVP.D5.DE.27). SHALL carry a version identifier for the certificate template. Used by verifiers to select the human-readable text template (REQ-DE-24), apply version-appropriate validation logic, and determine compatibility." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "DVCMin.v" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "ICVPMin.d" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin.d" ] ;
       fhir:ElementDefinition.short [ fhir:value "Issuance date" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Date on which the ICVP was issued by the issuing authority." ] ;
       fhir:ElementDefinition.comment [ fhir:value "Date of issuance for the certificate; the capture date is not the same as the date of vaccination or the date of birth." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "SHALL carry the date on which the ICVP was issued by the issuing authority. This date supports validity checks, certificate age assessment, and interpretation of time-bound vaccine recommendations." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "ICVPMin.d" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "date" ]
       ]
     ]
  ] ;
  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "ICVPMin" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin" ] ;
       fhir:ElementDefinition.short [ fhir:value "ICVP HCERT Payload" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Minimal DVC payload for use within an HCERT Payload using the ICVP Product Catalogue" ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "ICVPMin.n" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin.n" ] ;
       fhir:ElementDefinition.comment [ fhir:value "LOINC 87226-7 'Legal name of patient - first and last'. Language per REQ-CC-04 (English or French)." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "Satisfies REQ-DE-01 (ICVP.A9.DE.1). SHALL carry the full name of the recipient, transcribed from the identity document used for travel, in the same form and order as it appears on that document." ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "ICVPMin.dob" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin.dob" ] ;
       fhir:ElementDefinition.comment [ fhir:value "LOINC 21112-8; SNOMED CT 184099003." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "Satisfies REQ-DE-02 (ICVP.A9.DE.2). SHALL be recorded as a fully specified calendar date. Partial dates on identity documents are resolved per national policy." ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "ICVPMin.s" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin.s" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Mapping governed by the ICVP.Core ConceptMap." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "Satisfies REQ-DE-03 (ICVP.A9.DE.3). SHALL record the sex of the recipient. Bound (extensible) to FHIR AdministrativeGender (male/female/other/unknown). Values not in the core set SHALL be mapped to 'unknown' (ICVP.A9.DE.7) for interoperability." ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "ICVPMin.nt" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin.nt" ] ;
       fhir:ElementDefinition.comment [ fhir:value "LOINC 69433-1; SNOMED CT 223369002." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "Satisfies REQ-DE-08 (ICVP.A9.DE.8). SHALL record a single ISO 3166-1 alpha-3 country code for the recipient's nationality. Stateless cases handled per national policy." ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "ICVPMin.id" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin.id" ] ;
       fhir:ElementDefinition.comment [ fhir:value "LOINC 76435-7. Pairs with dt (document type)." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "Satisfies REQ-DE-09 (ICVP.A9.DE.9) — document number component. MAY be populated per issuing State Party policy; SHOULD be populated where operationally feasible to support border-control identity binding (Coexistence 'Individual issuance'). Data-protection obligations per IHR Article 45 apply." ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "ICVPMin.dt" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin.dt" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Pairs with id (document number)." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "Satisfies REQ-DE-09 (ICVP.A9.DE.9) — document type component. Bound (extensible) to the HL7 v2 identifier-type value set. Resolves Coexistence footnote 23 ambiguity by modelling document type alongside id (document number)." ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "ICVPMin.gn" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin.gn" ] ;
       fhir:ElementDefinition.comment [ fhir:value "LOINC 79183-0; SNOMED CT 394619001." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "Satisfies REQ-DE-10 (ICVP.A9.DE.10). SHALL be present when the recipient is a minor or dependent (per issuing State Party policy); otherwise omitted. Where the parent/guardian holds their own travel identity document, record the name as it appears on that document. Wet-ink parent/guardian signature (Annex 6 non-digital) is not applicable — see REQ-CC-08." ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "ICVPMin.vx" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin.vx" ] ;
       fhir:ElementDefinition.requirements [ fhir:value "Satisfies REQ-CC-02 and REQ-CC-03: container for the single vaccine/prophylaxis administration represented by this certificate. Multiple administrations SHALL be issued as separate Digital ICVPs." ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMinVaccineDetails" ]
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "ICVPMin.v" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin.v" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Unrecognised versions SHOULD be treated as ambiguous, not rejected; verifier MAY fall back to the latest supported version and flag the discrepancy." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "Satisfies REQ-DE-27 (ICVP.D5.DE.27). SHALL carry a version identifier for the certificate template. Used by verifiers to select the human-readable text template (REQ-DE-24), apply version-appropriate validation logic, and determine compatibility." ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "ICVPMin.d" ] ;
       fhir:ElementDefinition.path [ fhir:value "ICVPMin.d" ] ;
       fhir:ElementDefinition.short [ fhir:value "Issuance date" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Date on which the ICVP was issued by the issuing authority." ] ;
       fhir:ElementDefinition.comment [ fhir:value "Date of issuance for the certificate; the capture date is not the same as the date of vaccination or the date of birth." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "SHALL carry the date on which the ICVP was issued by the issuing authority. This date supports validity checks, certificate age assessment, and interpretation of time-bound vaccine recommendations." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "date" ]
       ]
     ]
  ] .

