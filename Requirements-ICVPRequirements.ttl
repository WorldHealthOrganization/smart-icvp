  ], [
     fhir:index 9 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.description" ] ;
     fhir:Extension.valueMarkdown [ fhir:value "Normative requirements governing the core data elements of the Digital International Certificate of Vaccination or Prophylaxis (Digital ICVP). Each statement traces back to IHR (2005) Annex 6/7, the WHO Coexistence guidance, and the WHO Specifications for the Digital ICVP, and is linked via satisfiedBy to the corresponding ICVPMin / ICVPMinVaccineDetails element." ]
  ], [
     fhir:index 10 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.jurisdiction" ]
  ], [
     fhir:index 11 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.purpose" ] ;
     fhir:Extension.valueMarkdown [ fhir:value "Provide a machine-readable, traceable statement of the regulatory and normative requirements for the Digital ICVP, supporting conformance assessment of the ICVPMin logical model, profiles, value sets and decision-support logic defined in this IG." ]
  ], [
     fhir:index 12 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.copyright" ] ;
     fhir:Extension.valueMarkdown [ fhir:value "© World Health Organization, 2026. Licensed under CC-BY-SA-3.0-IGO." ]
  ], [
     fhir:index 13 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-CC-01" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "No departure from the Model" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL conform to the Model ICVP specified in Annex 6. Implementations SHALL NOT add, remove or rename core data elements; they MAY extend the dictionary with additional local elements only where this does not displace or contradict any required element. Layout and colour of the digital background do not affect validity." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 §2; WHO Coexistence document §260306" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 14 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-CC-02" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Three logical sections" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "A Digital ICVP SHALL represent all three sections of the Model ICVP: (1) information about the recipient (ICVPMin.n, dob, s, nt, id, dt, gn — ICVP.A9.DE.1–A9.DE.10); (2) list of vaccine(s) or prophylaxis(es) administered (ICVPMin.vx / ICVPMinVaccineDetails — ICVP.C5.DE.11–C5.DE.19); (3) basic information to ascertain validity (ICVPMin.v and HCERT envelope — ICVP.D5.DE.20–D5.DE.27)." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6; WHO Coexistence document" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 15 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-CC-03" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Individuality of the certificate" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "A Digital ICVP instance SHALL describe exactly one recipient; bundling multiple recipients in a single signed payload is NOT PERMITTED. Each signed ICVPMin payload SHALL correspond to exactly one administered dose of one vaccine or prophylaxis product. Separate certificates SHALL be issued for children and for each administration." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 §7; WHO Coexistence document §260306" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 16 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-CC-04" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Language of completion" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "All required string-typed fields (e.g. ICVPMin.n, gn, vaccine details) SHALL be present in English or French. Implementations MAY carry parallel translations in additional languages; translations SHALL NOT replace the English or French representation." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 §5" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 17 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-CC-05" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "No amendment or erasure" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "Once signed, the payload SHALL NOT be modified. Any required correction SHALL be issued as a new certificate. This is enforced through the cryptographic integrity check on the HCERT payload." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 §6" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 18 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-CC-06" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "WHO-approved vaccine or prophylaxis" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The product recorded in ICVPMinVaccineDetails.vp SHALL be drawn from the ICVP Product Catalogue (ICVPProductIds), derived from the WHO List of Prequalified Vaccines, the WHO Emergency Use Listing (EUL) procedure, and the WHO Prequalified Finished Pharmaceutical Products list. A certificate referencing a product not on this catalogue SHALL be deemed invalid by ICVP.DT.1 and ICVP.DT.2." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 §3" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMinVaccineDetails" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 19 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-CC-07" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Naming of the issuer" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The certificate SHALL bear the name of the clinician supervising the administration or of the relevant authority responsible for issuing the certificate or overseeing the administering centre. In the minimal payload this is enforced by the invariant must-have-issuer-or-clinician-name on DVCMinVaccineDetails, requiring at least one of cn (REQ-DE-14) or is (REQ-DE-15) to be present." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 §4" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMinVaccineDetails" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 20 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-CC-08" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Wet-ink artefacts not applicable" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHOULD-NOT" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "Recipient signature, guardian signature, clinician signature and official centre stamp apply only to the non-digital format and SHALL NOT be carried in the Digital ICVP payload. These are replaced by the HCERT cryptographic signature (REQ-DE-25)." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "WHO Coexistence document, Table 2" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 21 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-CC-09" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Applicability" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP profiled in this IG SHALL be used only for certificates issued on or after 19 September 2025, and only for State Parties for which the 2024 amendments to the Model ICVP are in force." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "WHO Coexistence document, citing op. paragraph 2.(2) of WHA77.17" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 22 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-CC-10" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Verifiability" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "A Digital ICVP SHALL be verifiable — its integrity and authenticity cryptographically validatable by any party in possession of the QR code payload and access to the GDHCN trust list, without recourse to the issuer. Verifiability is operationalised jointly by REQ-DE-25, REQ-DE-26, REQ-DE-15 and REQ-CC-05." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "WHO Coexistence document §260306" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 23 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-CC-11" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Selective disclosure" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHOULD" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHOULD support selective disclosure, enabling the traveller to display only the relevant QR code or specific data required for inspection. Issuers delivering through a traveller-facing application SHOULD use the ICVPSD profile; issuers whose delivery channel is a single printed QR code MAY use the plain ICVPMin profile. Selective disclosure SHALL NOT be used to omit data elements designated Required by Table 2 at issuance time." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "WHO Coexistence document §260306" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPSD" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 24 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-01" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Name of the recipient (ICVP.A9.DE.1 → ICVPMin.n)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL carry the full name of the recipient of the vaccine or prophylaxis, transcribed usually from the identity document the recipient intends to use for travel. The recipient is the natural person who actually received the vaccine (subject). The issuer SHALL record the name in the same form and order as it appears in the name field of the identity document used for travel. Coding: ICVP.Core #ICVP.A9.DE.1; LOINC 87226-7. Cardinality 1..1, type string, Required." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP; WHO Coexistence Table 2" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin#ICVPMin.n" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 25 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-02" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Date of birth (ICVP.A9.DE.2 → ICVPMin.dob)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The recipient's date of birth SHALL be recorded as a fully specified calendar date. Where the identity document shows a partial date (e.g. only a year), the issuer SHOULD apply national policy to complete the field. Coding: ICVP.Core #ICVP.A9.DE.2; LOINC 21112-8; SNOMED CT 184099003. Cardinality 1..1, type date, Required." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP; WHO Coexistence Table 2" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin#ICVPMin.dob" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 26 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-03" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Sex (ICVP.A9.DE.3 → ICVPMin.s)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL record the sex of the recipient. Bound (extensible) to FHIR AdministrativeGender (male/female/other/unknown) via the mappings defined in the ICVP.Core ConceptMap. Usually the value corresponds to the sex indicated on the identity document; values that do not map directly (e.g. 'X' on some passports) MAY be extended or mapped to an existing permissible value. For interoperability, extended values not in the core value set SHALL be mapped to 'unknown' (ICVP.A9.DE.7). Coding: ICVP.Core #ICVP.A9.DE.3. Cardinality 1..1, type code, Required." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP; WHO Coexistence Table 2; ICVP Core Data Dictionary" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin#ICVPMin.s" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 27 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-08" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Nationality (ICVP.A9.DE.8 → ICVPMin.nt)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL record the nationality of the recipient as an ISO 3166-1 alpha-3 country code (extensible). ICVPMin.nt is cardinality 1..1 — the minimal payload records a single nationality, usually the one on the recipient's identity document. Cases where nationality cannot be established (e.g. stateless persons) SHOULD be handled according to national policy. Coding: ICVP.Core #ICVP.A9.DE.8; LOINC 69433-1; SNOMED CT 223369002. Type code, Required." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP; WHO Coexistence Table 2" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin#ICVPMin.nt" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 28 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-09" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "National identification document (ICVP.A9.DE.9 → ICVPMin.id + ICVPMin.dt)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHOULD" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP MAY carry an identifier from an official national identity document (e.g. national ID card, passport). Inclusion is governed by the policy of the issuing State Party. The Coexistence document endorses this element for identity binding at border control ('inspection of the ICVP vis-à-vis the national identification document, if applicable'), so issuers SHOULD populate it wherever operationally feasible. To resolve the Model ICVP ambiguity (footnote 23) between document number and document type, the IG supports both: id (0..1, string — document number) and dt (0..1, code — document type bound to HL7 v2 $identifierTypeVS, extensible). Implementations SHOULD populate both where available, and SHALL ensure any identifier carried complies with the data-protection regime of the issuing State Party (IHR Article 45). Coding: ICVP.Core #ICVP.A9.DE.9; LOINC 76435-7. Optional / If applicable." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP; IHR Article 45; WHO Coexistence Table 2 and footnote 23; Coexistence 'Individual issuance' validity criterion" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin#ICVPMin.dt" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 29 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-10" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Name of the parent or guardian (ICVP.A9.DE.10 → ICVPMin.gn)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL carry the full name of the parent or guardian when applicable — that is, when the recipient is a minor or dependent, as defined by the policy of the issuing State Party. Where applicable, gn SHALL be present; otherwise it SHALL be omitted. Where the parent/guardian holds their own travel identity document, the issuer SHOULD record the name as it appears on that document, to facilitate border-control identity binding. The wet-ink signature of a parent or guardian required by Annex 6 for non-digital ICVPs is not applicable in the digital format (REQ-CC-08). Coding: ICVP.Core #ICVP.A9.DE.10; LOINC 79183-0; SNOMED CT 394619001. Cardinality 0..1, type string, Required if applicable (Conditional)." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP; WHO Coexistence Table 2; ICVP Core Data Dictionary" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin#ICVPMin.gn" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 30 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-11" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Vaccine or prophylaxis (ICVP.C5.DE.11 → ICVPMinVaccineDetails.vp)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL carry the identifier of the vaccine or prophylaxis product administered. vp is bound with strength required to ICVPProductIds (the curated ICVP Product Catalogue derived from the WHO List of Prequalified Vaccines, the WHO EUL procedure, and the WHO Prequalified Finished Pharmaceutical Products list). A certificate carrying a value outside ICVPProductIds SHALL be rejected as invalid by ICVP.DT.1 (yellow fever), ICVP.DT.2 (poliovirus) and any future Annex 7 disease-specific tables. The name of disease (ICVP.C5.DE.12) and manufacturer (ICVP.C5.DE.16) are NOT separately populated — verifiers SHALL derive them from vp via the ICVP Product Catalogue. Coding: ICVP.Core #ICVP.C5.DE.11; LOINC 39236-5; SNOMED CT 787859002. Cardinality 1..1, type code, Required." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP §3; WHO Coexistence Table 2 and footnotes 25–27" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/ValueSet/ICVPProductIds" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 31 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-12" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Name of disease or condition — derived (ICVP.C5.DE.12)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "ICVP.C5.DE.12 (name of disease or condition) is NOT independently populated in ICVPMinVaccineDetails. Verifiers SHALL derive it deterministically from vp via the ICVP Product Catalogue. Issuers MAY display the derived value on the human-readable view but SHALL NOT carry it in the signed payload." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "WHO Coexistence footnotes 25–27; ICVP Core Data Dictionary validation rule 'Must correspond to the disease targeted by the selected vaccine or prophylaxis product'" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/ValueSet/ICVPProductIds" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 32 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-13" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Date of vaccination (ICVP.C5.DE.13 → ICVPMinVaccineDetails.dv)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL carry the date on which the vaccine or prophylaxis was administered, as a full calendar date. This date is the anchor for all temporal-validity calculations (see REQ-DE-20, REQ-DE-21/22/23). The administration date SHALL NOT be later than the certificate's issuance date and SHALL NOT be later than the date the certificate is presented for verification. The administration date MAY precede the issuance date. Coding: ICVP.Core #ICVP.C5.DE.13; LOINC 30952-6. Cardinality 1..1, type date, Required." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMinVaccineDetails#ICVPMinVaccineDetails.dv" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 33 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-14" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Name of supervising clinician (ICVP.C5.DE.14 → ICVPMinVaccineDetails.cn)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "MAY" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP MAY carry the full name of the medical practitioner or other authorised health worker who supervised the administration. This field is the digital counterpart of the 'Name of supervising clinician' column in the Annex 6 Model table — but NOT of the wet-ink signature, which is not applicable in the digital format (REQ-CC-08). Either cn (this field) or is (REQ-DE-15) SHALL be present, per the invariant must-have-issuer-or-clinician-name on DVCMinVaccineDetails. Coding: ICVP.Core #ICVP.C5.DE.14. Cardinality 0..1, type string, Conditional." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 §4; Annex 6 Model ICVP; WHO Coexistence Table 2; ICVP Core Data Dictionary" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMinVaccineDetails#ICVPMinVaccineDetails.cn" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 34 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-15" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Issuing authority (ICVP.C5.DE.15 → ICVPMinVaccineDetails.is)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHOULD" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP MAY carry the identifier of the relevant authority responsible for issuing the certificate or overseeing the administering centre. This identifier SHALL correspond to a participant onboarded to the WHO Global Digital Health Certification Network (GDHCN) trust framework, as expressed in the SMART Trust ValueSet-Participants — this binding is what makes cryptographic verification possible at the border. Either cn (REQ-DE-14) or is (this field) SHALL be present, per the invariant must-have-issuer-or-clinician-name on DVCMinVaccineDetails. Certificates intended for international border verification SHOULD populate is — without it, the certificate cannot be cryptographically verified through the GDHCN. Coding: ICVP.Core #ICVP.C5.DE.15. Cardinality 0..1, type id, Conditional." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 §4; WHO Coexistence Table 2; ICVP Core Data Dictionary validation condition" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMinVaccineDetails#ICVPMinVaccineDetails.is" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 35 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-16" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Manufacturer of vaccine or prophylaxis — derived (ICVP.C5.DE.16)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "ICVP.C5.DE.16 (manufacturer) is NOT independently populated in ICVPMinVaccineDetails. It is derived at verification time from vp via the ICVP Product Catalogue. Issuers MAY display the derived manufacturer on the human-readable view but SHALL NOT carry it in the signed payload." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "WHO Coexistence footnote 27" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/ValueSet/ICVPProductIds" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 36 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-17" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Batch number (ICVP.C5.DE.17 → ICVPMinVaccineDetails.bo)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL carry the batch (lot) number of the vaccine or prophylaxis administered, as recorded by the manufacturer. The minimal payload collapses DE.18 (string) and DE.19 (coded) into a single string field bo for HCERT compactness; where a coded catalogue of batches is available, the issuer SHOULD still populate bo with the manufacturer's canonical batch identifier so that recall and pharmacovigilance lookups remain possible. bo SHALL NOT be omitted, even where national policy might otherwise treat batch as administrative metadata (Coexistence footnote 28: 'The batch No. [number] is required.'). Coding: ICVP.Core #ICVP.C5.DE.17; LOINC 30959-1. Cardinality 1..1, type string, Required." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP ('Manufacturer and batch No.'); WHO Coexistence Table 2 and footnotes 27–28" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMinVaccineDetails#ICVPMinVaccineDetails.bo" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 37 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-18" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Batch number (string) — collapsed (ICVP.C5.DE.18)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "ICVP.C5.DE.18 (batch number, string representation) is collapsed into the single field bo (REQ-DE-17) in ICVPMinVaccineDetails." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "ICVP Core Data Dictionary" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMinVaccineDetails#ICVPMinVaccineDetails.bo" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 38 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-19" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Batch number (coded) — collapsed / out of scope (ICVP.C5.DE.19)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "ICVP.C5.DE.19 (batch number, coded representation) is collapsed into bo (REQ-DE-17). Coded batch representations are out of scope for the minimal HCERT payload." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "ICVP Core Data Dictionary" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMinVaccineDetails#ICVPMinVaccineDetails.bo" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 39 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-20" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Certificate valid from (ICVP.D5.DE.20)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL carry a 'valid from' date, carried in the HCERT envelope (issued-at / not-before claim). Per Coexistence footnote 30, this date is CALCULATED from the date of administration (ICVPMinVaccineDetails.dt, REQ-DE-13) according to disease-specific rules. For yellow fever, Annex 7 §2.(a).(iv) sets the offset at ten days after the date of vaccination. Issuer implementations SHALL compute this date deterministically using the rules embedded in ICVP.DT.1 (yellow fever) and ICVP.DT.2 (poliovirus). The certificate SHALL NOT be presented as valid before this date. Coding: ICVP.Core #ICVP.D5.DE.20. Type date, cardinality 1..1, Required." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP; IHR (2005) Annex 7 §2.(a).(iv); WHO Coexistence Table 2 and footnote 30" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 40 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-21" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Certificate valid until — selector (ICVP.D5.DE.21)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL carry a 'valid until' value for each vaccine or prophylaxis recorded, modelled as a discriminated union with two variants: lifetime (DE.22, string) and bounded (DE.23, date). Encoding is carried in the HCERT envelope (expires-at claim, with disease-specific encoding). Coding: ICVP.Core #ICVP.D5.DE.21. Cardinality 1..1, Required." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP; WHO Coexistence Table 2 and footnote 29" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 41 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-22" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Certificate valid until — lifetime variant (ICVP.D5.DE.22)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "Used when the vaccine confers lifelong protection. Per Coexistence footnote 29 and Annex 7 §2.(a).(iii), one full dose of yellow-fever vaccine confers lifelong protection; the value SHALL be encoded as the literal string 'life of person vaccinated' (English) or 'vie entière du sujet vacciné' (French), in conformance with REQ-CC-04. No other free-text values are permitted. Coding: ICVP.Core #ICVP.D5.DE.22. Type string." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 7 §2.(a).(iii); WHO Coexistence footnote 29" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 42 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-23" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Certificate valid until — bounded variant (ICVP.D5.DE.23)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "Used for vaccines whose protection is time-limited. The value SHALL be a full calendar date computed from dt (REQ-DE-13) according to the disease-specific rule. Per Coexistence footnote 30, the 'valid until' date SHALL be computed by the issuer from the administration date and the applicable disease-specific rule; it SHALL NOT be entered manually in a way that contradicts the rule. The certificate SHALL be deemed invalid by the verifier on or after the day following this date, except where the lifetime variant (REQ-DE-22) is in use. Coding: ICVP.Core #ICVP.D5.DE.23. Type date." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 7 §2.(a).(iii)–(iv); WHO Coexistence footnote 30" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 43 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-24" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Standard text following the Annex 6 table (ICVP.D5.DE.24)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "Annex 6 prescribes literal text that SHALL appear following the vaccine table on every Model ICVP. The Digital ICVP SHALL display this text on its human-readable view, in English or French (REQ-CC-04). The wording is fixed by Annex 6 and SHALL NOT be paraphrased — it includes the WHO-approval qualifier, the rules on amendment and erasure, and the language-of-completion rule. Because this text is invariant and fully determined by the Model ICVP, it is NOT carried as a payload field in ICVPMin — it is rendered by the verifier or human-readable viewer from a static template keyed off the certificate Version (REQ-DE-27). Implementations SHALL keep the text in their presentation layer synchronised with the version of Annex 6 to which the certificate conforms. Coding: ICVP.Core #ICVP.D5.DE.24. Type string (fixed), cardinality 1..1, Required." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 Model ICVP (text following the table); WHO Coexistence Table 2" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 44 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-25" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Cryptographic signature of the issuer (ICVP.D5.DE.25)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL be cryptographically signed by the issuing authority. The signature SHALL be applied over the canonical encoding of the ICVPMin payload using the GDHCN signing conventions (COSE_Sign1 over the HCERT CBOR payload). The signature is the digital substitute for the Annex 6 wet-ink artefacts identified as not applicable in REQ-CC-08. Per REQ-CC-05, once signed, the payload SHALL NOT be modified. Coding: ICVP.Core #ICVP.D5.DE.25. Carried in HCERT envelope (COSE_Sign1 signature)." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "IHR (2005) Annex 6 §4–§6; WHO Coexistence Table 2 ('Integrity Check' row, footnote 32)" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 45 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-26" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Key identifier for signature verification (ICVP.D5.DE.26)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL carry a key identifier that allows the verifier to locate the issuer's public key in the GDHCN trust list. The identifier SHALL be resolvable to a participant in the SMART Trust ValueSet-Participants (cross-referenced by REQ-DE-15). Verifier implementations SHALL use this identifier to retrieve the public key and validate the signature; if the key cannot be resolved or is no longer trusted, the verifier SHALL treat the certificate as non-authentic. Coding: ICVP.Core #ICVP.D5.DE.26. Carried in HCERT envelope (COSE kid header)." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "WHO Coexistence Table 2 ('Integrity Check')" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 46 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "REQ-DE-27" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.label" ] ;
       fhir:Extension.valueString [ fhir:value "Version (ICVP.D5.DE.27 → ICVPMin.v)" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.conformance" ] ;
       fhir:Extension.valueCode [ fhir:value "SHALL" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "The Digital ICVP SHALL carry a version identifier for the certificate template, indicating the version of the Specifications document and the corresponding Model ICVP to which the certificate conforms. Verifiers SHALL use v to (a) select the correct human-readable text template for REQ-DE-24, (b) apply version-appropriate validation logic (data dictionary, decision-support tables, value sets), and (c) determine compatibility with the verifier's own implementation. A certificate carrying a v value that the verifier does not recognise SHOULD be treated as ambiguous rather than rejected outright: the verifier MAY fall back to the latest version it supports and flag the discrepancy to the inspector for human judgement. Coding: ICVP.Core #ICVP.D5.DE.27. Cardinality 1..1, type string, Required." ]
     ], [
       fhir:index 4 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.derivedFrom" ] ;
       fhir:Extension.valueString [ fhir:value "WHO Coexistence Table 2 and footnote 33" ]
     ], [
       fhir:index 5 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.satisfiedBy" ] ;
       fhir:Extension.valueUrl [ fhir:value "http://smart.who.int/icvp/StructureDefinition/ICVPMin#ICVPMin.v" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ] ;
  fhir:Basic.code [
     fhir:CodeableConcept.coding [
       fhir:index 0 ;
       fhir:Coding.system [ fhir:value "http://hl7.org/fhir/fhir-types" ] ;
       fhir:Coding.code [ fhir:value "Requirements" ]
     ]
  ] .

